---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import DateSpan from '../components/DateSpan.astro';
import headshot from '../assets/headshot.jpg';
import { about, uab, highSchool, awards, aiLiteracy } from '../data/education';
import { roles, byStart } from '../data/roles';
import { rich } from '../data/rich';
const earlier = roles.filter((r) => r.kind === 'earlier').sort(byStart);
const groups = [
  ['university', 'At UAB'],
  ['highschool', 'High School'],
  ['certificate', 'Certificates'],
] as const;
---
<Base title="About" description={about.short}>
  <!-- the story on the left; the photo stays beside it until the story ends -->
  <section class="wrap intro" data-tone="cardinal">
    <div class="txt">
      <span class="label">About</span>
      <h1 data-split>Computer Science <em>&amp;</em> <span class="outline">Physics</span></h1>
      <p class="lead" data-reveal>{about.short}</p>
      <div class="story">
        {about.long.map((p) => <p class="para rich" data-words set:html={rich(p)} />)}
      </div>
    </div>
    <div class="pic-col">
      <div class="pic" data-reveal>
        <Image src={headshot} alt="Rodion Mayatskiy" widths={[420, 640, 900]} sizes="(max-width: 860px) 90vw, 36vw" loading="eager" />
      </div>
    </div>
  </section>

  <section class="wrap section edu-sec" id="education" aria-labelledby="edu-h" data-tone="sand">
    <span class="label">Education</span>
    <h2 id="edu-h" data-reveal><span class="fillword" data-fill data-text="Education">Education</span></h2>
    <div class="edu">
      <article class="uni" data-reveal>
        <DateSpan {...uab.span} note="expected" />
        <h3 class="school">{uab.school}</h3>
        <p class="degree">{uab.degree}</p>
        <dl class="facts">
          <div><dt>Concentration</dt><dd>{uab.concentration}</dd></div>
          <div><dt>Minors</dt><dd>{uab.minors}</dd></div>
          <div><dt>Programs</dt><dd>{uab.honors}</dd></div>
        </dl>
        <ul class="marks">{uab.lines.map((l) => <li class="rich" set:html={rich(l)} />)}</ul>
        <div class="cw">
          <div>
            <p class="cw-h">Completed <b class="num">{uab.completed.length}</b></p>
            <ul class="pills done">{uab.completed.map((c) => <li>{c}</li>)}</ul>
          </div>
          <div>
            <p class="cw-h">In progress, Fall 2026 <b class="num">{uab.inProgress.length}</b></p>
            <ul class="pills now">{uab.inProgress.map((c) => <li>{c}</li>)}</ul>
          </div>
        </div>
      </article>
      <aside class="side" data-reveal>
        <p class="gpa"><span class="num gradient">{uab.gpa}</span><span>GPA at UAB</span></p>
        <article class="hs">
          <p class="hs-when">{highSchool.dates}</p>
          <h3>{highSchool.school}</h3>
          <ul class="marks">{highSchool.lines.map((l) => <li class="rich" set:html={rich(l)} />)}</ul>
        </article>
      </aside>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="awards-h" data-tone="cardinal">
    <span class="label">Recognition</span>
    <h2 id="awards-h" data-reveal><span class="fillword" data-fill data-text="Awards">Awards</span></h2>
    <div class="awards">
      {groups.map(([g, label]) => {
        const list = awards.filter((a) => a.group === g);
        return (
          <div class:list={['grp', `grp-${g}`]} data-reveal>
            <h3 class="grp-h">{label} <span class="num">{list.length}</span></h3>
            <ul class="aw">
              {list.map((a) => <li>{a.year && <span class="yr">{a.year}</span>}<span class="rich t" set:html={rich(a.title)} /></li>)}
            </ul>
          </div>
        );
      })}
    </div>
  </section>

  <section class="wrap section ai" aria-labelledby="ai-h" data-tone="third">
    <div class="ai-head">
      <span class="label third">AI literacy</span>
      <h2 id="ai-h" data-split>AI, <em>used well</em></h2>
      <p class="lead rich" data-reveal set:html={rich(aiLiteracy.intro)} />
    </div>
    <ol class="points">
      {aiLiteracy.points.map((pt, i) => (
        <li data-reveal>
          <span class="n num" aria-hidden="true">0{i + 1}</span>
          <div><h3>{pt.title}</h3><p class="rich" set:html={rich(pt.text)} /></div>
        </li>
      ))}
    </ol>
  </section>

  <section class="wrap section" aria-labelledby="earlier-h" data-tone="sand">
    <span class="label">Before UAB</span>
    <h2 id="earlier-h" data-reveal><span class="fillword" data-fill data-text="Earlier">Earlier</span></h2>
    <ol class="earlier">
      {earlier.map((r) => (
        <li data-reveal>
          <p class="when">{r.dates}</p>
          <h3>{r.title}</h3>
          <p class="org">{r.org}{r.place ? ` · ${r.place}` : ''}</p>
          <p class="line rich" set:html={rich(r.cardLine)} />
          {r.link && <a class="more-link" href={r.link.href} rel="noopener" target="_blank"><span class="t">{r.link.label}</span><span class="arrow" aria-hidden="true">↗</span></a>}
        </li>
      ))}
    </ol>
  </section>
</Base>

<style>
  .intro { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr); gap: clamp(30px, 5vw, 90px); padding-top: clamp(130px, 14vw, 200px); padding-bottom: var(--section); }
  h1 { font-size: clamp(3rem, 1.6rem + 5vw, 6.6rem); text-transform: uppercase; letter-spacing: -0.045em; line-height: 0.88; margin: 14px 0 26px; }
  h1 em { font-family: var(--serif); font-style: italic; font-weight: 400; color: var(--sand); text-transform: none; }
  .story { display: grid; gap: 6px; margin-top: clamp(30px, 4vw, 56px); }
  .para { font: 500 clamp(1.2rem, 0.95rem + 0.9vw, 1.75rem) / 1.42 var(--display); letter-spacing: -0.015em; max-width: none; }
  /* the photo column runs the full height of the story, so the photo can stay in view while it is read */
  .pic { position: sticky; top: clamp(96px, 12vh, 140px); border-radius: 20px; overflow: hidden; aspect-ratio: 4 / 5; background: #000; box-shadow: 0 40px 90px -40px rgba(140, 21, 21, 0.55); }
  .pic :global(img) { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.08); transition: filter 1s var(--ease-out); }
  .pic::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 40%, var(--cardinal)); mix-blend-mode: multiply; transition: opacity 1s; }
  .pic:hover :global(img) { filter: none; } .pic:hover::after { opacity: 0.3; }

  section h2 { margin: 18px 0 clamp(30px, 4vw, 54px); }

  /* education: no boxes; a glow that ends inside its own box, and a tonal panel for the side column */
  .edu-sec { position: relative; isolation: isolate; }
  .edu-sec::before { content: ''; position: absolute; z-index: -1; inset: -10% -15%; pointer-events: none; background: radial-gradient(closest-side at 30% 45%, color-mix(in srgb, var(--cardinal) 20%, transparent), transparent), radial-gradient(closest-side at 80% 60%, rgba(212, 165, 116, 0.07), transparent); }
  .edu { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr); gap: clamp(30px, 5vw, 80px); }
  .school { margin: 22px 0 8px; font-size: clamp(1.6rem, 1.1rem + 1.6vw, 2.5rem); color: var(--sand); }
  .degree { margin: 0 0 22px; font: 700 1.15rem var(--display); color: var(--ink); }
  .facts { display: grid; gap: 10px; margin: 0 0 24px; }
  .facts div { display: grid; grid-template-columns: 9.5em minmax(0, 1fr); gap: 14px; align-items: baseline; }
  .facts dt { font: italic 400 1.15rem var(--serif); color: var(--sand); }
  .facts dd { margin: 0; font-weight: 500; }
  .marks { list-style: none; padding: 0; margin: 0 0 30px; display: grid; gap: 12px; }
  .marks li { position: relative; padding-left: 22px; }
  .marks li::before { content: ''; position: absolute; left: 0; top: 0.62em; width: 8px; height: 8px; border-radius: 2px; transform: rotate(45deg); background: var(--glow); box-shadow: 0 0 10px var(--glow); }
  .cw { display: grid; gap: 22px; }
  .cw-h { margin: 0 0 10px; font: 700 1rem var(--display); color: var(--ink); }
  .cw-h b { margin-left: 6px; padding: 2px 9px; border-radius: 999px; font-size: 0.85rem; color: var(--bg); background: var(--sand); }
  .pills { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .pills li { padding: 7px 13px; border-radius: 999px; font-size: 0.9rem; }
  .pills.done li { color: var(--sand); background: rgba(212, 165, 116, 0.12); }
  .pills.now li { color: var(--third); background: color-mix(in srgb, var(--third) 11%, transparent); }
  .pills.now li::before { content: ''; display: inline-block; width: 6px; height: 6px; margin-right: 8px; border-radius: 50%; vertical-align: 0.15em; background: var(--third); box-shadow: 0 0 8px var(--third); }
  .side { align-self: start; display: grid; gap: 26px; padding: clamp(24px, 3vw, 40px); background: radial-gradient(closest-side at 40% 35%, color-mix(in srgb, var(--sand) 9%, transparent), transparent); }
  .gpa { display: flex; align-items: baseline; gap: 14px; margin: 0; }
  .gpa .num { font: 800 clamp(5rem, 3rem + 5vw, 8rem) / 0.85 var(--display); letter-spacing: -0.05em; }
  .gpa span:last-child { font: italic 400 1.3rem var(--serif); color: var(--sand); }
  .hs-when { margin: 0 0 6px; font: 700 0.95rem var(--display); color: var(--third); }
  .hs h3 { font-size: clamp(1.25rem, 1rem + 0.8vw, 1.6rem); margin-bottom: 16px; }
  .hs .marks { margin: 0; }

  /* awards: three columns, each award with its year above it, no rules between rows */
  .awards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(26px, 3vw, 44px) clamp(24px, 3.5vw, 56px); align-items: start; }
  .grp-h { display: flex; align-items: center; gap: 10px; margin: 0 0 16px; padding-bottom: 14px; font-size: 1.35rem; color: var(--sand); background: linear-gradient(90deg, rgba(212, 165, 116, 0.45), transparent) 0 100% / 100% 1px no-repeat; }
  .grp-h .num { padding: 2px 10px; border-radius: 999px; font-size: 0.85rem; color: var(--bg); background: var(--sand); }
  .aw { list-style: none; padding: 0; margin: 0; display: grid; gap: 4px; }
  .aw li { display: grid; gap: 4px; padding: 12px 14px; margin-inline: -14px; border-radius: 14px; transition: background 0.3s; }
  .aw li:hover { background: color-mix(in srgb, var(--sand) 7%, transparent); }
  .aw .t { color: color-mix(in srgb, var(--ink) 84%, transparent); text-align: left; }
  .yr { font: 700 0.85rem var(--display); color: var(--third); }

  /* AI: the heading stays on the left while four titled points run down the right */
  .ai { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: clamp(30px, 5vw, 90px); align-items: start; }
  .ai-head { position: sticky; top: clamp(100px, 14vh, 150px); }
  .ai-head h2 { margin-bottom: 26px; }
  .ai-head .lead { text-align: left; text-wrap: pretty; } /* a narrow column: justified, its large type opens wide gaps */
  .points { list-style: none; padding: 0; margin: 0; counter-reset: none; }
  .points li { position: relative; display: grid; grid-template-columns: 4.6rem minmax(0, 1fr); gap: 18px; padding-block: clamp(22px, 2.6vw, 34px); transition: transform 0.5s var(--ease-out); }
  .points li + li::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px; background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--third) 50%, transparent) 30%, transparent); }
  .points .n { font: 800 3.2rem / 0.9 var(--display); color: transparent; -webkit-text-stroke: 1.3px var(--third); transition: color 0.5s var(--ease-out); }
  .points li:hover { transform: translateX(6px); }
  .points li:hover .n { color: color-mix(in srgb, var(--third) 35%, transparent); }
  .points h3 { margin: 4px 0 10px; font-size: clamp(1.25rem, 1rem + 0.7vw, 1.6rem); }
  .points p { margin: 0; text-align: left; }

  /* earlier: a dated list with a glowing marker per entry */
  .earlier { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 34px clamp(30px, 5vw, 70px); }
  .earlier li { position: relative; padding-left: 26px; }
  .earlier li::before { content: ''; position: absolute; left: 0; top: 6px; bottom: 0; width: 2px; border-radius: 2px; background: linear-gradient(var(--glow), transparent); box-shadow: 0 0 10px rgba(212, 68, 68, 0.5); }
  .when { margin: 0 0 6px; font: 700 0.95rem var(--display); color: var(--third); }
  .earlier h3 { font-size: 1.3rem; margin: 0 0 6px; }
  .org { margin: 0 0 8px; font-size: 0.95rem; color: var(--sand); }
  .line { margin: 0 0 10px; }

  @media (max-width: 860px) {
    .intro, .edu, .awards, .ai, .earlier { grid-template-columns: 1fr; }
    .ai-head { position: static; }
    .pic-col { order: -1; }
    .pic { position: relative; top: 0; max-width: 420px; }
    .facts div { grid-template-columns: 1fr; gap: 2px; }
  }
</style>
