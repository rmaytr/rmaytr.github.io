---
// A date range as a rose strip: from, a line that fills with how far through it the site was when it was built, to.
interface Props { from: string; to: string; start: string; end: string; note?: string; }
const { from, to, start, end, note } = Astro.props;
const done = Math.min(1, Math.max(0, (Date.now() - Date.parse(start)) / (Date.parse(end) - Date.parse(start))));
---
<p class="span"><b>{from}</b><span class="visually-hidden"> to </span><span class="track" aria-hidden="true"><i style={`--p:${done.toFixed(3)}`}></i></span><b>{to}</b>{note && <em>{note}</em>}</p>

<style>
  .span { display: inline-flex; align-items: center; gap: 12px; width: max-content; max-width: 100%; margin: 0; padding: 11px 18px; border-radius: 999px; font: 800 1rem / 1 var(--display); letter-spacing: -0.01em; color: var(--ink); text-align: left; background: color-mix(in srgb, var(--third) 10%, transparent); border: 1px solid color-mix(in srgb, var(--third) 55%, transparent); box-shadow: 0 0 30px -10px var(--third); }
  .track { position: relative; flex: none; width: clamp(44px, 7vw, 110px); height: 2px; border-radius: 2px; background: color-mix(in srgb, var(--ink) 22%, transparent); }
  .track i { position: absolute; inset: 0 auto 0 0; width: calc(var(--p) * 100%); border-radius: 2px; background: var(--third); box-shadow: 0 0 10px var(--third); }
  .track i::after { content: ''; position: absolute; right: -4px; top: -3px; width: 8px; height: 8px; border-radius: 50%; background: var(--third); box-shadow: 0 0 10px 2px var(--third); }
  em { font: italic 400 1.1rem var(--serif); color: var(--sand); }
</style>
