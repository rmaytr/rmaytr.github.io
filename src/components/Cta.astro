---
// The call to action: a dark glass capsule warmed by a cardinal glow, holding a label that rolls over to a sand copy
// and a badge whose ring of text turns slowly round an arrow. On hover the capsule's glow rises, a cardinal fill swells
// in the badge and the arrow passes through.
interface Props { href: string; label: string; big?: boolean; arrow?: string; class?: string; [attr: string]: unknown; }
const { href, label, big = false, arrow = '→', class: cls, ...rest } = Astro.props;
const unit = `${label} · `;
// repeat the label until the ring is about full, so the letters keep an even spacing whatever the label's length
const ring = [...unit.repeat(Math.max(1, Math.round((big ? 40 : 30) / unit.length))).toUpperCase()];
---
<a class:list={['cta', { big }, cls]} href={href} {...rest}>
  <span class="t"><span>{label}</span><span aria-hidden="true">{label}</span></span>
  <span class="badge" aria-hidden="true" style={`--n:${ring.length}`}>
    <span class="ring">{ring.map((c, i) => <i style={`--i:${i}`}>{c}</i>)}</span>
    <span class="core"><span class="arw">{arrow}</span></span>
  </span>
</a>

<style>
  .cta { --b: 72px; --pad: 8px; position: relative; isolation: isolate; display: inline-flex; align-items: center; gap: 22px; width: max-content; padding: var(--pad) var(--pad) var(--pad) 30px; border-radius: 999px; color: var(--ink); text-decoration: none; font: 700 clamp(1.1rem, 1rem + 0.4vw, 1.35rem) / 1 var(--display); letter-spacing: -0.01em; }
  .cta.big { --b: 96px; --pad: 10px; gap: 28px; padding-left: 40px; font-size: clamp(1.5rem, 1.1rem + 1.2vw, 2.3rem); text-transform: uppercase; letter-spacing: -0.02em; }
  /* the capsule: dark glass with a cardinal glow rising from the left, a fine sand rim, and an ember halo beneath */
  .cta::before { content: ''; position: absolute; inset: 0; z-index: -1; border-radius: inherit; background: radial-gradient(130% 170% at 0% 50%, rgba(140, 21, 21, 0.6), transparent 62%), linear-gradient(100deg, rgba(32, 23, 24, 0.94), rgba(18, 14, 15, 0.94)); box-shadow: inset 0 0 0 1px rgba(212, 165, 116, 0.32), inset 0 1px 0 rgba(255, 255, 255, 0.08), 0 22px 54px -22px rgba(212, 68, 68, 0.6); transition: box-shadow 0.7s var(--ease-out); }
  /* a soft light that sweeps across the capsule every few seconds */
  .cta::after { content: ''; position: absolute; inset: 0; z-index: -1; border-radius: inherit; pointer-events: none; background: linear-gradient(110deg, transparent 38%, rgba(255, 236, 214, 0.14) 50%, transparent 62%) 200% 0 / 230% 100% no-repeat; animation: cta-sheen 6s ease-in-out infinite; }
  .cta:hover::before, .cta:focus-visible::before { box-shadow: inset 0 0 0 1px rgba(212, 68, 68, 0.65), inset 0 1px 0 rgba(255, 255, 255, 0.1), 0 28px 74px -18px rgba(212, 68, 68, 0.9); }

  .t { display: inline-block; overflow: hidden; height: 1.15em; line-height: 1.15em; }
  /* the label is ivory at rest and rolls to a sand copy on hover */
  .t span { display: block; transition: transform 0.7s var(--ease-inout); }
  .t span + span { color: var(--sand); }
  .cta:hover .t span, .cta:focus-visible .t span { transform: translateY(-100%); }

  .badge { position: relative; flex: none; display: grid; place-items: center; width: var(--b); height: var(--b); transition: transform 0.9s var(--ease-out); }
  .ring { position: absolute; inset: 0; color: color-mix(in srgb, var(--ink) 80%, transparent); animation: cta-spin 18s linear infinite; transition: color 0.6s; }
  .ring i { position: absolute; left: 50%; top: 0; width: 1em; height: 50%; margin-left: -0.5em; text-align: center; font: normal 600 calc(var(--b) * 0.105) / 1 var(--mono); transform-origin: 50% 100%; transform: rotate(calc(var(--i) * 360deg / var(--n))); }
  .core { position: relative; display: grid; place-items: center; width: 52%; height: 52%; border-radius: 50%; overflow: hidden; color: var(--ink); background: rgba(243, 237, 228, 0.06); border: 1.5px solid rgba(243, 237, 228, 0.5); transition: color 0.6s, border-color 0.6s, transform 0.25s var(--ease-out); }
  .core::before { content: ''; position: absolute; inset: 0; border-radius: 50%; background: radial-gradient(circle, var(--glow), var(--cardinal) 70%); transform: scale(0); transition: transform 0.8s var(--ease-out); }
  .arw { position: relative; font: 700 calc(var(--b) * 0.22) / 1 var(--display); }

  .cta:hover .badge, .cta:focus-visible .badge { transform: rotate(-14deg) scale(1.06); }
  .cta:hover .ring, .cta:focus-visible .ring { color: var(--sand); }
  .cta:hover .core, .cta:focus-visible .core { color: var(--ink); border-color: var(--glow); }
  .cta:hover .core::before, .cta:focus-visible .core::before { transform: scale(1); }
  .cta:hover .arw, .cta:focus-visible .arw { animation: cta-through 0.8s var(--ease-inout); }
  .cta:active .core { transform: scale(0.9); }

  @keyframes cta-spin { to { transform: rotate(360deg); } }
  @keyframes cta-sheen { 0%, 62% { background-position: 200% 0; } 100% { background-position: -130% 0; } }
  /* the arrow leaves to the right and comes back in from the left */
  @keyframes cta-through { 45% { transform: translateX(170%); } 46% { transform: translateX(-170%); } }
  @media (max-width: 600px) { .cta { --b: 62px; padding-left: 22px; gap: 14px; } .cta.big { --b: 78px; padding-left: 26px; } }
</style>
