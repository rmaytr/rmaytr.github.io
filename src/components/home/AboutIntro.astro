---
import Cta from '../Cta.astro';
import { Image } from 'astro:assets';
import headshot from '../../assets/headshot.jpg';
import { about } from '../../data/education';
const facts = [
  { v: '4.0', l: 'GPA, Presidential Honors List' },
  { v: 'Honors', l: 'College, Personalized Pathway' },
  { v: 'B.S.–M.S.', l: 'Early admission, accelerated program in AI' },
  { v: 'UAB', l: 'Birmingham, Alabama' },
];
---
<section class="section wrap about" id="about" aria-labelledby="about-h" data-tone="sand">
  <div class="pic" data-reveal>
    <Image src={headshot} alt="Rodion Mayatskiy" widths={[360, 560, 760]} sizes="(max-width: 860px) 90vw, 32vw" loading="lazy" />
  </div>
  <div class="txt">
    <span class="label">About</span>
    <h2 id="about-h" data-split>About <em>me</em></h2>
    <p class="statement" data-words>{about.intro}</p>
    <ul class="facts">
      {facts.map((f) => <li data-reveal><b>{f.v}</b><span>{f.l}</span></li>)}
    </ul>
    <Cta href="/about/" label="More about me" data-magnetic data-reveal />
  </div>
</section>

<style>
  .about { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(32px, 5vw, 80px); align-items: center; }
  .pic { position: relative; border-radius: var(--radius); overflow: hidden; aspect-ratio: 4 / 5; background: #000; }
  .pic :global(img) { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.08); transition: filter 0.9s var(--ease-out), transform 1.2s var(--ease-out); }
  .pic::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 35%, var(--cardinal)); mix-blend-mode: multiply; transition: opacity 0.9s; }
  .pic:hover :global(img) { filter: none; transform: scale(1.03); }
  .pic:hover::after { opacity: 0.3; }
  .statement { font: 500 clamp(1.25rem, 0.95rem + 1.05vw, 1.9rem) / 1.35 var(--display); letter-spacing: -0.015em; margin: 26px 0 30px; max-width: none; }
  .facts { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; list-style: none; margin: 0 0 30px; padding: 0; }
  .facts li { background: var(--bg-2); border: 1px solid var(--line); border-radius: 12px; padding: 14px; }
  .facts b { display: block; font: 800 1.45rem var(--display); background: linear-gradient(90deg, var(--glow), var(--sand)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .facts span { color: var(--ink) !important; opacity: 0.8; }
  .label { margin-bottom: 18px; }
  .facts span { font-size: 0.8rem; color: var(--muted); }
  @media (max-width: 860px) { .about { grid-template-columns: 1fr; } .pic { max-width: 420px; } .facts { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
