---
import DateSpan from '../DateSpan.astro';
import { uab } from '../../data/education';
import { rich } from '../../data/rich';
---
<section class="section wrap" id="education" aria-labelledby="edu-h">
  <div class="edu" data-reveal>
    <div class="left">
      <div class="when">
        <span class="label">Education</span>
        <DateSpan {...uab.span} note="expected" />
      </div>
      <h2 id="edu-h"><span class="echo" data-text="Education">Education</span></h2>
      <p class="school">{uab.school}</p>
      <p class="degree">{uab.degree}</p>
      <p class="muted">Concentration: {uab.concentration} · Minors: {uab.minors}</p>
      <p class="muted">{uab.honors}</p>
    </div>
    <div class="right">
      <p class="gpa"><span class="num gradient">{uab.gpa}</span><span class="meta">GPA</span></p>
      <ul>{uab.lines.map((l) => <li class="rich" set:html={rich(l)} />)}</ul>
      <a class="more-link" href="/about/#education"><span class="t">See coursework</span><span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  /* no box: a soft cardinal light behind the text. closest-side makes each glow reach nothing before the edge of
     its own box, so no straight edge ever shows */
  .edu { position: relative; isolation: isolate; display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: clamp(24px, 4vw, 70px); padding-block: clamp(26px, 4vw, 56px); }
  .edu::before { content: ''; position: absolute; z-index: -1; inset: -40% -20%; pointer-events: none; background: radial-gradient(closest-side at 32% 50%, color-mix(in srgb, var(--cardinal) 24%, transparent), color-mix(in srgb, var(--cardinal) 10%, transparent) 50%, transparent), radial-gradient(closest-side at 76% 48%, rgba(212, 165, 116, 0.07), transparent); }
  .when { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 14px; margin-bottom: 18px; }
  .right { padding-left: clamp(0px, 3vw, 48px); border-left: 1px solid color-mix(in srgb, var(--sand) 18%, transparent); }
  @media (max-width: 860px) { .right { padding-left: 0; border-left: 0; } }
  .school { text-align: start; color: var(--sand); font: 700 clamp(1.3rem, 1rem + 1vw, 1.9rem) / 1.15 var(--display); margin: 18px 0 6px; }
  .degree { margin: 0 0 14px; }
  .gpa { display: flex; align-items: baseline; gap: 12px; margin: 0; }
  .gpa .num { font: 800 clamp(5rem, 3rem + 6vw, 8.5rem) / 0.9 var(--display); letter-spacing: -0.05em; }
  .right ul { padding-left: 18px; margin: 10px 0 18px; }
  .right li { margin-bottom: 8px; }
  @media (max-width: 860px) { .edu { grid-template-columns: 1fr; } }
</style>
