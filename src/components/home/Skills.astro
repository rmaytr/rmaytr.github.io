---
import { SKILLS, GROUPS } from '../../data/skills';
const counts = Object.fromEntries(Object.keys(GROUPS).map((k) => [k, SKILLS.filter((s) => s[2] === k).length]));
---
<section class="section" id="skills" aria-labelledby="skills-h" data-tone="third">
  <div class="wrap section-head">
    <span class="label third">Skills</span>
    <h2 id="skills-h" data-split>The periodic table <em>of skills</em></h2>
    <p class="lead" data-reveal>Every tool I work with, as an element, grouped in blocks. Move over them; click one to see what it is and where I used it. With a keyboard, the arrow keys walk the table.</p>
  </div>
  <div class="tools wrap" data-reveal>
    <div class="legend" role="group" aria-label="Highlight a group">
      {Object.entries(GROUPS).map(([k, [label, col]]) => (
        <button type="button" data-group={k} aria-pressed="false" style={`--cat:${col}`}>
          <span class="sw" aria-hidden="true">{counts[k]}</span><span class="gl">{label}</span>
        </button>
      ))}
    </div>
    <div class="seg" role="group" aria-label="Shape">
      <button type="button" data-lay="table" aria-pressed="true">Table</button>
      <button type="button" data-lay="sphere" aria-pressed="false">Sphere</button>
      <button type="button" data-lay="helix" aria-pressed="false">Helix</button>
    </div>
  </div>
  <div class="stage" data-ptable data-shape="table">
    <span class="spot" aria-hidden="true"></span>
    <div class="world" data-world>
      {SKILLS.map(([sym, name, group], i) => (
        <button type="button" class="el" data-i={i} data-g={group} style={`--cat:${GROUPS[group][1]}`} aria-label={`${name}, ${GROUPS[group][0]}`} aria-pressed={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
          <span class="z">{i + 1}</span><span class="s">{sym}</span><span class="n">{name}</span>
        </button>
      ))}
    </div>
    <aside class="info" aria-live="polite" data-info>
      <div class="big" style={`--cat:${GROUPS[SKILLS[0][2]][1]}`}><span class="sym">{SKILLS[0][0]}</span></div>
      <div class="txt">
        <p class="grp">{GROUPS[SKILLS[0][2]][0]} · No. 1</p>
        <h3>{SKILLS[0][1]}</h3>
        <p class="what">{SKILLS[0][3]}</p>
        <p class="used"><span>Used in</span> {SKILLS[0][5]}</p>
        <a class="more-link" href={SKILLS[0][4]} rel="noopener" target="_blank"><span class="t">What is {SKILLS[0][1]}?</span><span class="arrow" aria-hidden="true">↗</span></a>
      </div>
    </aside>
  </div>
  <script type="application/json" data-skills set:html={JSON.stringify(SKILLS.map(([s, n, g, w, l, u]) => ({ s, n, g: GROUPS[g][0], c: GROUPS[g][1], w, l, u })))} />
</section>

<style>
  .tools { display: flex; flex-wrap: wrap; gap: 14px 24px; align-items: center; justify-content: space-between; margin-bottom: 18px; }
  .legend { display: flex; flex-wrap: wrap; gap: 8px; }
  .legend button { display: inline-flex; align-items: center; gap: 9px; padding: 5px 12px 5px 5px; border-radius: 10px; cursor: pointer; background: color-mix(in srgb, var(--cat) 10%, var(--bg-2)); border: 1px solid color-mix(in srgb, var(--cat) 45%, transparent); transition: transform 0.3s var(--ease-out), background 0.3s, box-shadow 0.3s; }
  .legend button:hover { transform: translateY(-2px); }
  .legend button[aria-pressed='true'] { background: color-mix(in srgb, var(--cat) 30%, var(--bg-2)); box-shadow: 0 0 22px -6px var(--cat); }
  .sw { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 7px; background: color-mix(in srgb, var(--cat) 72%, white); color: #120c0d; font: 800 0.8rem var(--display); }
  .gl { font: 600 0.82rem var(--text); color: var(--ink); }
  .seg { display: flex; gap: 4px; padding: 4px; border-radius: 999px; background: var(--bg-2); border: 1px solid var(--line); }
  .seg button { font: 600 0.85rem var(--text); background: transparent; border: 0; padding: 8px 16px; border-radius: 999px; cursor: pointer; color: var(--ink); transition: background 0.25s, color 0.25s; }
  .seg button[aria-pressed='true'] { background: var(--third); color: var(--bg); }

  .stage { position: relative; width: min(1400px, calc(100vw - 32px)); margin-inline: calc(50% - min(700px, 50vw - 16px)); height: 720px; border-radius: 26px; overflow: hidden; perspective: 1600px; touch-action: pan-y; background: radial-gradient(ellipse at 60% 30%, color-mix(in srgb, var(--third-deep) 18%, transparent), transparent 60%), linear-gradient(180deg, #151112, #0e0b0b); border: 1px solid var(--line); transition: height 0.8s var(--ease-inout); }
  .stage[data-shape='table'] { height: 620px; }
  .spot { position: absolute; width: 520px; height: 520px; left: var(--sx, 50%); top: var(--sy, 50%); margin: -260px; border-radius: 50%; background: radial-gradient(circle, color-mix(in srgb, var(--third) 12%, transparent), transparent 65%); pointer-events: none; }
  .world { position: absolute; left: 50%; top: 50%; width: 0; height: 0; transform-style: preserve-3d; }
  .el { position: absolute; width: 64px; height: 78px; margin: -39px 0 0 -32px; border-radius: 10px; background: linear-gradient(160deg, color-mix(in srgb, var(--cat) 30%, #1a1415), color-mix(in srgb, var(--cat) 12%, #120e0f)); border: 1px solid color-mix(in srgb, var(--cat) 60%, transparent); cursor: pointer; padding: 6px 7px; display: flex; flex-direction: column; justify-content: space-between; text-align: left; transition: transform 1.1s var(--ease-inout), opacity 0.4s, box-shadow 0.25s, background 0.25s; color: var(--ink); }
  .el .z { font: 600 0.6rem var(--mono); color: color-mix(in srgb, var(--ink) 85%, transparent); }
  .el .s { font: 800 1.7rem / 1 var(--display); letter-spacing: -0.03em; }
  .el .n { font: 500 0.56rem / 1.1 var(--text); color: color-mix(in srgb, var(--ink) 85%, transparent); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .el:hover, .el.on { background: color-mix(in srgb, var(--cat) 55%, #1a1415); box-shadow: 0 0 28px -2px var(--cat); }
  .el.on { outline: 2px solid var(--ink); outline-offset: 2px; }
  .el.dim { opacity: 0.14; }

  /* the detail card is docked to the left, beside the table rather than inside it */
  .info { position: absolute; z-index: 2; left: 24px; top: 50%; width: 360px; transform: translateY(-50%); display: grid; gap: 18px; align-content: start; padding: 24px; border-radius: 20px; background: rgba(14, 11, 11, 0.86); border: 1px solid rgba(243, 237, 228, 0.16); }
  .big { display: grid; place-items: center; width: 96px; height: 110px; border-radius: 14px; background: linear-gradient(160deg, color-mix(in srgb, var(--cat) 45%, #1a1415), #120e0f); border: 1px solid color-mix(in srgb, var(--cat) 70%, transparent); box-shadow: 0 0 34px -8px var(--cat); }
  .sym { font: 800 3rem / 1 var(--display); letter-spacing: -0.04em; }
  .grp { margin: 0 0 4px; font: 600 0.72rem var(--mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--sand); }
  .info h3 { font-size: clamp(1.4rem, 1.1rem + 0.8vw, 1.9rem); }
  .what { margin: 8px 0 10px; font-size: 0.98rem; color: var(--ink); }
  .used { margin: 0 0 12px; font-size: 0.88rem; color: var(--ink); opacity: 0.85; }
  .used span { font: 600 0.68rem var(--mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--third); margin-right: 6px; }
  /* set by the script when the stage is too narrow for a side card: the card goes under the shape */
  .stage[data-narrow] { height: auto !important; min-height: 420px; }
  .stage[data-narrow] .info { position: relative; left: 0; top: 0; width: auto; transform: none; grid-template-columns: auto minmax(0, 1fr); gap: 20px; margin: 0 12px 12px; }
  @media (max-width: 700px) {
    .stage[data-narrow] .info { grid-template-columns: 1fr; }
    .big { width: 72px; height: 82px; }
  }
</style>

<script>
  import { onPage, reducedMotion } from '../../scripts/page';
  type Skill = { s: string; n: string; g: string; c: string; w: string; l: string; u: string };
  type Pos = { x: number; y: number; z: number; ry: number; rx: number };
  const DX = 70, DY = 84, ROWS = 6, GAP = 0.4; // GAP: the space between group blocks, in columns
  const SIDE = 1100; // from this stage width the card sits beside the shape
  const INFO_W = 360; // the docked card's width in the CSS; read as a constant, since its live width changes with the layout
  const BLOCKS = 700; // from this width the table keeps its group blocks; below it, a plain grid

  onPage(() => {
    const stage = document.querySelector<HTMLElement>('[data-ptable]');
    const world = document.querySelector<HTMLElement>('[data-world]');
    const info = document.querySelector<HTMLElement>('[data-info]');
    const data = document.querySelector<HTMLScriptElement>('[data-skills]');
    if (!stage || !world || !info || !data) return;
    const skills: Skill[] = JSON.parse(data.textContent ?? '[]');
    const els = [...world.querySelectorAll<HTMLButtonElement>('.el')];
    const reduce = reducedMotion();
    const n = els.length;
    const side = () => stage.clientWidth >= SIDE;
    const sideW = () => (side() ? INFO_W + 48 : 0);
    const cols = () => Math.max(4, Math.floor((stage.clientWidth - 16) / DX));

    // each group is a block of columns filled top to bottom, all standing on one base line, so the top edge steps
    const blocks = (() => {
      const cells: Array<[number, number]> = new Array(n);
      let col = 0;
      const groups = [...new Set(els.map((e) => e.dataset.g ?? ''))];
      groups.forEach((g, gi) => {
        const members = els.map((e, i) => [e, i] as const).filter(([e]) => e.dataset.g === g);
        members.forEach(([, i], k) => {
          const c = Math.floor(k / ROWS), inCol = Math.min(ROWS, members.length - c * ROWS);
          cells[i] = [col + c, ROWS - inCol + (k % ROWS)];
        });
        col += Math.ceil(members.length / ROWS) + (gi < groups.length - 1 ? GAP : 0);
      });
      return { cells, width: col };
    })();

    const layouts: Record<string, () => Pos[]> = {
      table: () => {
        if (stage.clientWidth < BLOCKS) {
          const c = cols(), rows = Math.ceil(n / c);
          return els.map((_, i) => ({ x: ((i % c) - (c - 1) / 2) * DX, y: (Math.floor(i / c) - (rows - 1) / 2) * DY, z: 0, ry: 0, rx: 0 }));
        }
        return blocks.cells.map(([c, r]) => ({ x: (c - (blocks.width - 1) / 2) * DX, y: (r - (ROWS - 1) / 2) * DY, z: 0, ry: 0, rx: 0 }));
      },
      sphere: () => els.map((_, i) => { const phi = Math.acos(-1 + (2 * i + 1) / n), th = Math.sqrt(n * Math.PI) * phi, R = 290; const x = R * Math.cos(th) * Math.sin(phi), y = R * Math.cos(phi), z = R * Math.sin(th) * Math.sin(phi); return { x, y, z, ry: (Math.atan2(x, z) * 180) / Math.PI, rx: (-Math.asin(y / R) * 180) / Math.PI }; }),
      helix: () => els.map((_, i) => { const a = i * 0.42, R = 360; return { x: Math.sin(a) * R, y: -260 + i * 8.8, z: Math.cos(a) * R, ry: (a * 180) / Math.PI, rx: 0 }; }),
    };
    let lay = 'table', pos = layouts.table(), rotX = 0, rotY = 0, tRotX = 0, tRotY = 0, scale = 1, raf = 0, current = 0;
    let ptr: [number, number] | null = null, drag: [number, number, number, number] | null = null;
    const lift = new Array<number>(n).fill(0);

    const fit = () => {
      const avail = stage.clientWidth - sideW() - 40;
      if (lay !== 'table') scale = Math.min(1, avail / 820);
      else scale = stage.clientWidth < BLOCKS ? 1 : Math.min(1, avail / ((blocks.width + 0.2) * DX));
    };
    // beside the card the shape centres in the space left over; stacked, it sits on top at its scaled height
    const place = () => {
      const stacked = !side();
      stage.toggleAttribute('data-narrow', stacked);
      const cx = (stage.clientWidth + sideW()) / 2;
      world.style.left = stacked ? '' : `${cx}px`;
      stage.style.perspectiveOrigin = stacked ? '' : `${cx}px 50%`; // so the sphere and helix turn about their own centre
      const rows = stage.clientWidth < BLOCKS ? Math.ceil(n / cols()) : ROWS;
      const h = (lay === 'sphere' ? 2 * 290 + 160 : lay === 'helix' ? (n - 1) * 8.8 + 160 : rows * DY) * scale;
      world.style.top = stacked ? `${h / 2 + 24}px` : ''; info.style.marginTop = stacked ? `${h + 48}px` : '';
    };
    const draw = () => {
      els.forEach((e, i) => { const p = pos[i]; e.style.transform = `translate3d(${p.x}px,${p.y}px,${p.z + lift[i]}px) rotateY(${p.ry}deg) rotateX(${p.rx}deg) scale(${1 + lift[i] / 170})`; });
      world.style.transform = `scale(${scale}) rotateX(${rotX}deg) rotateY(${rotY}deg)`;
    };
    const apply = (name: string) => {
      lay = name; stage.dataset.shape = name; pos = layouts[name](); fit(); place(); rotX = rotY = tRotX = tRotY = 0;
      els.forEach((e, i) => { e.style.transitionDuration = ''; e.style.transitionDelay = reduce ? '0ms' : `${(i % 18) * 12 + Math.floor(i / 18) * 30}ms`; });
      draw();
      document.querySelectorAll<HTMLElement>('[data-lay]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.lay === name)));
    };
    const select = (i: number) => {
      const k = skills[i];
      current = i;
      els.forEach((e, j) => { e.classList.toggle('on', j === i); e.setAttribute('aria-pressed', String(j === i)); e.tabIndex = j === i ? 0 : -1; });
      info.querySelector<HTMLElement>('.big')!.style.setProperty('--cat', k.c);
      info.querySelector('.sym')!.textContent = k.s;
      info.querySelector('.grp')!.textContent = `${k.g} · No. ${i + 1}`;
      info.querySelector('h3')!.textContent = k.n;
      info.querySelector('.what')!.textContent = k.w;
      const used = info.querySelector<HTMLElement>('.used')!; used.hidden = !k.u; used.lastChild!.textContent = ` ${k.u}`;
      const a = info.querySelector<HTMLAnchorElement>('a')!; a.href = k.l; a.querySelector('.t')!.textContent = `What is ${k.n}?`;
    };
    const filter = (g: string | null) => {
      document.querySelectorAll<HTMLElement>('[data-group]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.group === g)));
      els.forEach((e) => e.classList.toggle('dim', !!g && e.dataset.g !== g));
    };

    // pointer positions in world space, measured from where the world's centre sits on the stage
    const onMove = (e: PointerEvent) => {
      const r = stage.getBoundingClientRect(), ox = parseFloat(world.style.left) || stage.clientWidth / 2, oy = world.offsetTop;
      stage.style.setProperty('--sx', `${e.clientX - r.left}px`); stage.style.setProperty('--sy', `${e.clientY - r.top}px`);
      ptr = [(e.clientX - r.left - ox) / scale, (e.clientY - r.top - oy) / scale];
      if (drag) { tRotY = drag[2] + (e.clientX - drag[0]) * 0.3; tRotX = drag[3] - (e.clientY - drag[1]) * 0.2; }
    };
    const onLeave = () => { ptr = null; };
    const onDown = (e: PointerEvent) => { if (lay !== 'table' && !(e.target as HTMLElement).closest('.info')) drag = [e.clientX, e.clientY, tRotY, tRotX]; };
    const onUp = () => { drag = null; };
    stage.addEventListener('pointermove', onMove); stage.addEventListener('pointerleave', onLeave); stage.addEventListener('pointerdown', onDown); addEventListener('pointerup', onUp);
    els.forEach((e, i) => {
      e.addEventListener('click', () => select(i));
      e.addEventListener('focus', () => { if (lay === 'table') ptr = [pos[i].x, pos[i].y]; });
      e.addEventListener('blur', () => { ptr = null; });
    });
    const onKey = (ev: KeyboardEvent) => {
      const step: Record<string, number> = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 };
      let next = current;
      if (ev.key in step) next = (current + step[ev.key] + n) % n;
      else if (ev.key === 'Home') next = 0;
      else if (ev.key === 'End') next = n - 1;
      else return;
      ev.preventDefault(); select(next); els[next].focus();
    };
    world.addEventListener('keydown', onKey);
    document.querySelectorAll<HTMLElement>('[data-lay]').forEach((b) => b.addEventListener('click', () => apply(b.dataset.lay ?? 'table')));
    document.querySelectorAll<HTMLElement>('[data-group]').forEach((b) => b.addEventListener('click', () => filter(b.getAttribute('aria-pressed') === 'true' ? null : (b.dataset.group ?? null))));
    const ro = new ResizeObserver(() => { pos = layouts[lay](); fit(); place(); draw(); }); ro.observe(stage);

    let visible = false;
    const io = new IntersectionObserver(([en]) => { visible = en.isIntersecting; }); io.observe(stage);
    const frame = () => {
      raf = requestAnimationFrame(frame);
      if (!visible) return;
      let moving = false;
      els.forEach((_, i) => {
        const want = lay === 'table' && ptr && !reduce ? Math.max(0, 50 - Math.hypot(pos[i].x - ptr[0], pos[i].y - ptr[1]) * 0.3) : 0;
        const d = want - lift[i]; if (Math.abs(d) > 0.05) { lift[i] += d * 0.18; moving = true; }
      });
      if (lay !== 'table') { if (!drag && !reduce && !ptr) tRotY += 0.06; if (ptr && !drag) tRotX = -ptr[1] * 0.04; }
      else { tRotX = ptr ? -ptr[1] * 0.01 : 0; tRotY = ptr ? ptr[0] * 0.006 : 0; }
      const dx = tRotX - rotX, dy = tRotY - rotY; if (Math.abs(dx) + Math.abs(dy) > 0.01) { rotX += dx * 0.08; rotY += dy * 0.08; moving = true; }
      if (moving) { els.forEach((e) => { e.style.transitionDelay = '0ms'; e.style.transitionDuration = lay === 'table' && ptr ? '0s' : ''; }); draw(); }
    };
    apply('table');
    frame();
    return () => { cancelAnimationFrame(raf); ro.disconnect(); io.disconnect(); removeEventListener('pointerup', onUp); };
  });
</script>
