---
// The signature visual for each case study: the phasor (Phasora), before/after bars (sofiakamal.art)
// and the sync pipeline (BOR Realty). HackBama uses the race scene instead.
interface Props { kind: 'phasora' | 'sofiakamal' | 'bor-realty'; }
const { kind } = Astro.props;
const bars = [
  { label: 'JavaScript', before: 1060, after: 58, unit: 'KB', fmt: ['~1,060 KB', '58 KB'] },
  { label: 'First paint', before: 10, after: 1.1, unit: 's', fmt: ['~10 s', '1.1 s'] },
  { label: 'Idle layout recalculations per 5 s', before: 303, after: 2, unit: '', fmt: ['303', '2'] },
];
const steps = [
  ['YouTube Data API v3', 'with an RSS fallback'],
  ['Node.js sync script', 'categorizes by hashtag and title, hides duplicate Shorts'],
  ['GitHub Actions', 'runs daily'],
  ['689 videos', 'filter, sort by date, paginate'],
];
---
{kind === 'phasora' && (
  <figure class="vis card" data-reveal>
    <canvas data-phasor aria-label="A rotating phasor tracing a wave; move the pointer to change its speed" role="img"></canvas>
    <figcaption class="meta">The name, literally: a rotating vector tracing a wave. Move across it to change the speed.</figcaption>
  </figure>
)}
{kind === 'sofiakamal' && (
  <figure class="vis card bars" data-reveal>
    {bars.map((b) => (
      <div class="bar" data-bars>
        <p class="meta">{b.label}</p>
        <div class="track"><span class="b before" style={`--w:100%`}>{b.fmt[0]}</span></div>
        <div class="track"><span class="b after" style={`--w:${Math.max(2, (b.after / b.before) * 100)}%`}>{b.fmt[1]}</span></div>
      </div>
    ))}
    <figcaption class="meta">Before and after the rebuild, drawn to scale.</figcaption>
  </figure>
)}
{kind === 'bor-realty' && (
  <figure class="vis card pipe" data-reveal>
    <ol>
      {steps.map(([a, b]) => <li data-step><b>{a}</b><span>{b}</span></li>)}
    </ol>
    <figcaption class="meta">The media library keeps itself current with no manual work.</figcaption>
  </figure>
)}

<style>
  .vis { padding: clamp(18px, 3vw, 32px); margin: 0; }
  canvas { width: 100%; height: 260px; }
  figcaption { margin-top: 14px; }
  .bar { margin-bottom: 22px; }
  .track { height: 34px; margin-top: 6px; }
  .b { display: flex; align-items: center; height: 100%; width: var(--w); padding-left: 12px; border-radius: 8px; font: 700 0.95rem var(--display); white-space: nowrap; transform-origin: left; }
  .before { background: color-mix(in srgb, var(--muted) 30%, transparent); }
  .after { background: linear-gradient(90deg, var(--cardinal), var(--glow)); min-width: max-content; padding-right: 12px; }
  .pipe ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; position: relative; }
  .pipe ol::before { content: ''; position: absolute; left: 6%; right: 6%; top: 22px; height: 2px; background: linear-gradient(90deg, var(--cardinal), var(--sand)); box-shadow: 0 0 12px var(--glow); }
  .pipe li { position: relative; padding-top: 48px; }
  .pipe li::before { content: ''; position: absolute; left: 50%; top: 14px; width: 18px; height: 18px; margin-left: -9px; border-radius: 50%; background: var(--bg-2); border: 2px solid var(--sand); box-shadow: 0 0 14px var(--glow); }
  .pipe b { display: block; font: 700 1.05rem var(--display); text-align: center; }
  .pipe span { display: block; text-align: center; color: var(--muted); font-size: 0.85rem; margin-top: 4px; }
  @media (max-width: 760px) { .pipe ol { grid-template-columns: 1fr 1fr; } .pipe ol::before { display: none; } }
</style>

<script>
  import { gsap } from '../../scripts/motion';
  import { onPage, reducedMotion } from '../../scripts/page';
  onPage(() => {
    const reduce = reducedMotion();
    const ctx = gsap.context(() => {
      if (reduce) return;
      document.querySelectorAll('[data-bars] .b').forEach((b, i) => gsap.from(b, { scaleX: 0, duration: 1.2, ease: 'expo.out', delay: (i % 2) * 0.25, scrollTrigger: { trigger: b, start: 'top 90%', once: true } }));
      const steps = document.querySelectorAll('[data-step]');
      if (steps.length) gsap.from(steps, { y: 30, opacity: 0, stagger: 0.15, duration: 0.8, ease: 'expo.out', scrollTrigger: { trigger: steps[0], start: 'top 85%', once: true } });
    });
    // phasor
    const c = document.querySelector<HTMLCanvasElement>('[data-phasor]');
    let raf = 0;
    if (c) {
      const x = c.getContext('2d')!, dpr = Math.min(2, devicePixelRatio);
      const fit = () => { c.width = c.clientWidth * dpr; c.height = c.clientHeight * dpr; x.setTransform(dpr, 0, 0, dpr, 0, 0); };
      const ro = new ResizeObserver(fit); ro.observe(c); fit();
      let w = 1.4, wt = 1.4, a = 0; const trail: number[] = [];
      c.addEventListener('pointermove', (e) => { const r = c.getBoundingClientRect(); wt = 0.6 + ((e.clientX - r.left) / r.width) * 3.2; });
      const loop = () => {
        raf = requestAnimationFrame(loop);
        const W = c.clientWidth, H = c.clientHeight, R = H * 0.36, cx = R + 18, cy = H / 2;
        w += (wt - w) * 0.05; a += reduce ? 0 : w * 0.016;
        trail.unshift(Math.sin(a)); if (trail.length > 600) trail.pop();
        x.clearRect(0, 0, W, H);
        x.strokeStyle = 'rgba(243,237,228,.14)'; x.lineWidth = 1; x.beginPath(); x.arc(cx, cy, R, 0, 7); x.stroke();
        x.beginPath(); x.moveTo(cx * 2, cy); x.lineTo(W, cy); x.stroke();
        const px = cx + Math.cos(a) * R, py = cy - Math.sin(a) * R;
        x.strokeStyle = '#d4a574'; x.lineWidth = 2; x.beginPath(); x.moveTo(cx, cy); x.lineTo(px, py); x.stroke();
        x.setLineDash([3, 4]); x.strokeStyle = 'rgba(212,165,116,.5)'; x.lineWidth = 1; x.beginPath(); x.moveTo(px, py); x.lineTo(cx * 2, py); x.stroke(); x.setLineDash([]);
        x.strokeStyle = '#d44444'; x.lineWidth = 2; x.shadowColor = '#d44444'; x.shadowBlur = 10; x.beginPath();
        trail.forEach((v, i) => { const tx = cx * 2 + i * 1.6; if (tx > W) return; if (i) x.lineTo(tx, cy - v * R); else x.moveTo(tx, cy - v * R); });
        x.stroke(); x.shadowBlur = 0;
        x.fillStyle = '#f3ede4'; x.beginPath(); x.arc(px, py, 3.5, 0, 7); x.fill();
        x.font = 'italic 18px "Instrument Serif", serif'; x.fillStyle = 'rgba(243,237,228,.8)'; x.fillText('x(t) = A cos(ωt + φ)', W - 170, 26);
      };
      loop();
      return () => { cancelAnimationFrame(raf); ro.disconnect(); ctx.revert(); };
    }
    return () => ctx.revert();
  });
</script>
